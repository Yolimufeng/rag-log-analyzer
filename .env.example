# 本地 Ollama 地址
OLLAMA_BASE_URL=http://127.0.0.1:11434

# 中文/多语言日志建议 bge-m3；也可换 nomic-embed-text
OLLAMA_EMBED_MODEL=bge-m3

# 生成模型：7B 起步，显存/内存不足可换 qwen2.5:3b-instruct
OLLAMA_LLM_MODEL=qwen2.5:7b-instruct

# ollama = 真实语义向量；hash = 无 Ollama 时离线联调（不具备语义能力）
EMBEDDING_PROVIDER=ollama

# 检索参数
TOP_K=3
CANDIDATE_K=15
SCORE_THRESHOLD=0.50

# 切片参数（字符数）
MAX_CHUNK_CHARS=600
CHUNK_OVERLAP=80
MAX_CONTEXT_CHARS=6000
